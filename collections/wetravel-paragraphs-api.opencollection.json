{
  "opencollection": "1.0.0",
  "info": {
    "name": "WeTravel Partner Access token Paragraphs API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Paragraphs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List paragraphs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wetravel.com/v2/draft_trips/:trip_uuid/paragraphs",
            "params": [
              {
                "name": "trip_uuid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Paragraphs"
        },
        {
          "info": {
            "name": "Create paragraph",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.wetravel.com/v2/draft_trips/:trip_uuid/paragraphs",
            "params": [
              {
                "name": "trip_uuid",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Paragraph"
        },
        {
          "info": {
            "name": "Get paragraph",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wetravel.com/v2/draft_trips/:trip_uuid/paragraphs/:id",
            "params": [
              {
                "name": "trip_uuid",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the paragraph.yml"
              }
            ]
          },
          "docs": "Get Paragraph"
        },
        {
          "info": {
            "name": "Update paragraph",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.wetravel.com/v2/draft_trips/:trip_uuid/paragraphs/:id",
            "params": [
              {
                "name": "trip_uuid",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the paragraph.yml"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Paragraph"
        },
        {
          "info": {
            "name": "Delete paragraph",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.wetravel.com/v2/draft_trips/:trip_uuid/paragraphs/:id",
            "params": [
              {
                "name": "trip_uuid",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the paragraph.yml"
              }
            ]
          },
          "docs": "Delete Paragraph"
        }
      ]
    }
  ],
  "bundled": true
}