              {
                "name": "trip_uuid",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the image"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Image"
        },
        {
          "info": {
            "name": "Delete image",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.wetravel.com/v2/draft_trips/:trip_uuid/images/:id",
            "params": [
              {
                "name": "trip_uuid",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the image"
              }
            ]
          },
