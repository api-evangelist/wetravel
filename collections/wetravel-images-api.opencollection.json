{
  "opencollection": "1.0.0",
  "info": {
    "name": "WeTravel Partner Access token Images API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
