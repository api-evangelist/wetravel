{
  "opencollection": "1.0.0",
  "info": {
    "name": "WeTravel Partner Access token Suppliers API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Suppliers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get supplier",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wetravel.com/v2/suppliers/:supplier_id",
            "params": [
              {
                "name": "supplier_id",
                "value": "",
                "type": "path",
                "description": "Supplier ID"
              }
            ]
          },
          "docs": "Get a supplier"
        },
        {
          "info": {
            "name": "List suppliers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wetravel.com/v2/suppliers",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page Number"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Suppliers per page"
              }
            ]
          },
          "docs": "Get a list of suppliers"
        }
      ]
    }
  ],
  "bundled": true
}